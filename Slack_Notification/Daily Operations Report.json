      "name": "Format"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Given this data: Tickets: {{ $('Format').item.json.data.Tickets }}, \nCalls: {{ $('Format').item.json.data.Calls }}, \nComplaints: {{ $('Format').item.json.data.Complaints }}, \nSLA Breaches: {{ $('Format').item.json.data.SLA_Breaches }}. \nWrite ONE short sentence summarizing today's operations.",
