    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  if (!item.json.Tickets || item.json.Tickets === '?') \n    item.json.Tickets = 0;\n  if (!item.json.Calls || item.json.Calls === '?') \n    item.json.Calls = 0;\n  if (!item.json.Complaints || item.json.Complaints === '?') \n    item.json.Complaints = 'Unknown';\n  if (!item.json.SLA_Breaches || item.json.SLA_Breaches === '?') \n    item.json.SLA_Breaches = 0;\n}\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -80,
        -80
      ],
      "id": "cc5cf5a0-37c4-4b96-9300-998a5b1325b0",
