    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst table = `*📊 Daily Operations Report — ${item.Date}*\n\n| Metric | Value |\n|--------|-------|\n| Tickets | ${item.Tickets} |\n| Calls | ${item.Calls} |\n| Complaints | ${item.Complaints} |\n| SLA Breaches | ${item.SLA_Breaches} |`;\n\nreturn [{ json: { report: table, data: item } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
